<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 接口层：开放接口、管理接口、审批中心接口、鉴权、健康检查，以及整个服务的组装。只做“读请求 → 调应用服务 → 写响应”，业务规则写在应用层、领域层和引擎里。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApprovalService.Contracts\ApprovalService.Contracts.csproj" />
    <ProjectReference Include="..\ApprovalService.Domain\ApprovalService.Domain.csproj" />
    <ProjectReference Include="..\ApprovalService.Application\ApprovalService.Application.csproj" />
    <ProjectReference Include="..\ApprovalService.Infrastructure\ApprovalService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApprovalService.Backend.Checks" />
  </ItemGroup>

</Project>
