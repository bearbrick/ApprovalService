<Project Sdk="Microsoft.NET.Sdk">

  <!--
    示例业务系统的“对接类库”：调审批接口、处理回调、取数接口、钩子这些对接代码都放这里，不依赖任何界面框架（设计书第 14 节）。
    同时编译到 .NET Framework 4.8 和 .NET 10：WinForms、Web 后端的业务系统照抄这个类库，界面换成自己的。
    示例业务系统的 WinUI 3 界面是另一个项目，只引用这个类库。
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>ApprovalService.Demo.Integration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApprovalService.Client\ApprovalService.Client.csproj" />
  </ItemGroup>

</Project>
